[Unit]
Description=Tabletop OS Raspberry Pi bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# HUB75 drops UID/GID without loading the target user's supplementary groups.
# Preserve serial access after the library drops privileges.
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/tabletop-os-bridge --config /etc/tabletop-os/tabletop-os.json
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
